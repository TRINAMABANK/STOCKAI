# StockAI Personal Configuration
# Cấu hình API Key bảo mật tại phía Server (Không để lộ ra Client/Git)

# OpenAI API Key (Bắt buộc nếu muốn sử dụng Trợ lý AI nâng cao)
OPENAI_API_KEY=

# Model OpenAI sử dụng (gpt-4o, gpt-4o-mini, gpt-4-turbo)
OPENAI_MODEL=gpt-4o

# Cấu hình BMSC (Bảo Minh Securities)
# Lưu ý: BMSC chưa có Public API mở tự do cho cá nhân.
# Hệ thống hỗ trợ nhập khẩu sao kê giao dịch / số dư CSV/Excel.
BMSC_CLIENT_CODE=
BMSC_ACCOUNT_NUMBER=

# Nguồn dữ liệu thị trường mặc định (vietstock, tcbs, ssi, mock)
MARKET_DATA_PROVIDER=vietstock

# Phí giao dịch và thuế mặc định (Việt Nam)
DEFAULT_TRADING_FEE_RATE=0.0015
DEFAULT_SELLING_TAX_RATE=0.0010
